[Unit]
Description=Translator (中英互译) Web Entry
After=network.target

[Service]
Type=simple
WorkingDirectory=/work/Translator/server
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/translator/translator.env
ExecStart=/usr/local/bin/gunicorn --workers 2 --threads 4 --bind 127.0.0.1:5030 --timeout 60 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
